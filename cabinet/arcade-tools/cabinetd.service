# Arcade cabinet buttons: front panel, MODE hotkey, button guide, shutdown confirm (cabinetd.py).
# Install: sudo cp cabinetd.service /etc/systemd/system/ && sudo systemctl enable --now cabinetd
[Unit]
Description=Arcade cabinet buttons
After=local-fs.target systemd-udev-settle.service

[Service]
ExecStart=/usr/bin/python3 /home/pi/arcade-tools/cabinetd.py
WorkingDirectory=/home/pi/arcade-tools
# The boards may not be ready at boot, or a board may be unplugged: try again.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
