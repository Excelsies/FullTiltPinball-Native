# Mode7Controller, ControlBallDrained (FT 0x429df0): the mode becomes 2, the mode timer is stopped (-1.0), then the ModeEnd
# cleanup runs (lamps v_lite45 / v_lite46 off).
init fixed_dt 10
init seed 1
init watch v_lite45.light_on v_lite46.light_on
10 key down new_game
11 key up new_game
50 poke info_text_box message_field 7
60 msg v_lite45 TLightTurnOn 0
61 expect v_lite45.light_on == 1
100 event info_text_box ControlBallDrained
100 expect mode == 2
100 expect v_lite45.light_on == 0
100 expect v_lite46.light_on == 0
200 quit
