# Mode7Controller, ControlMissionComplete (listing 4938-4960; FT 0x429c10): the pass targets and rocks are disabled, the mode
# lamps v_lite45 / v_lite46 flash until replaced, +100,000, text 3036 (until replaced), music track (slot 0x439af0).
init fixed_dt 10
init seed 1
init watch v_lite45.flasher_on v_lite46.flasher_on a_spot10.active a_spot14.active
10 key down new_game
11 key up new_game
50 poke info_text_box message_field 7
60 poke a_spot10 active 1
60 poke a_spot14 active 1
100 event info_text_box ControlMissionComplete
100 expect n_score == 100000 delta 99
100 expect text info_text_box display id 3036
100 expect mode == 7
100 expect a_spot10.active == 0
100 expect a_spot14.active == 0
100 expect v_lite45.flasher_on == 1
100 expect v_lite46.flasher_on == 1
200 quit
