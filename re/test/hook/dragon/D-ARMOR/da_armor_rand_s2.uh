init window 960 666
init fixed_dt 10
init seed 2
# AwardRandomArmor with three unlit lights: one RandIndex(3) draw picks the award (checked by check_da.py against
# n_rand_last: index = (r*3)>>15; 0 kickback +25000, 1 center post +50000, 2 armor post +100000). Repeated at 4 seeds.
init dump_period 10
