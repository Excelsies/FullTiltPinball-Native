init window 960 666
init fixed_dt 10
init seed 1
# OutlaneKickbackControl (FT 0x426d00, lines 2878-2903): on the kick timer, v_lite37 off -> the outlane group steps
# back; with no group light left a_kick1 is disarmed; the string 3009 is shown either way.
init dump_period 10
init watch a_kick1.active v_lite37.light_on
10 key down new_game
11 key up new_game
190 poke a_kick1 active 1
200 event a_kick1 ControlTimerExpired
201 expect a_kick1.active == 0
200-201 expect text info_text_box display id 3009
300 poke a_kick1 active 1
300 poke v_lite37 light_on 1
310 event a_kick1 ControlTimerExpired
311 expect a_kick1.active == 1
310-311 expect text info_text_box display id 3009
400 quit
