# Pause, mode 2 redisplay (companion of d_pause.uh, which covers the mode 10 text): after the skill shot (a_rebo1) the
# game is in mode 2; the second F3 at 851 clears the pause and redisplays the mode text 3001 through the 0x3f1 -> 0x50 remap
# along with the resume text 2004.
init window 960 666
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
200 key down plunger
300 key up plunger
320 event a_rebo1 ControlCollision
330 expect mode == 2
400 key down pause
401 key up pause
400 expect text info_text_box display id 2003
850 expect mode == 2
851 key down pause
852 key up pause
851-852 expect text info_text_box display id 2004
851-852 expect text info_text_box display id 3001
900 quit
