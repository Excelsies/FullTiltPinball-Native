# UnstuckBall, the >20 branch: ball 0 is placed at (3.0, 8.0), outside the
# bounds of a_flip1, a_flip3, a_flip2 and s_plunger1, and held there with speed 0 (hold resets position and speed every frame).
# The held ball counts as stationary: timed_frame calls UnstuckBall every frame once 500 ms have passed since the
# last activity. Hold at 401 -> first call in frame 450 (throw_ball: speed jumps, n_rand_draws +3 per call), the
# 21st call in frame 470 (StuckCounter 21 > 20): Disable, MultiballCount--, PlungerRelaunchBall puts the ball back at
# the plunger (-6.9575, 12.2083) at speed 0. The relaunch reuses ball 0
# and the hold moves it back to (3, 8) in the next frame, so only a dump at 470 shows it.
init window 960 666
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
200 key down plunger
300 key up plunger
400 place 0 3.0 8.0 0.37 0 0 0 0x1
401 hold 0 on
449 dump u449
450 dump u450
469 dump u469
470 dump u470
471 dump u471
900 dump u900
449 expect n_ball0_speed ~= 0.19177 0.01
450 expect n_ball0_speed in 0.1 3
469 expect n_ball0_speed in 0.1 3
470 expect n_ball0_x ~= -6.9575 0.05
470 expect n_ball0_y ~= 12.2083 0.05
470 expect n_ball0_speed == 0
470 expect multiball == 1
470 expect n_ball0_active == 1
900 expect multiball == 1
900 expect n_ball0_active == 1
920 quit
