# The 30 s watchdog (mode_timer ControlTimerExpired) during the count sets the step to 8: no further text, the earned
# total is NOT added (step 7 is skipped), the ball count drops.
init window 960 666
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
200 poke v_lite37 light_on 1
220 poke info_text_box message_field 11
300 event info_text_box ControlMissionComplete
300 expect text info_text_box display id 3014
310 event mode_timer ControlTimerExpired
311 expect bonus_step == 9
311 expect ball_count == 2
311-800 expect none text info_text_box display id 3017
800 expect n_score == 0
900 quit
