# Completing the bank (a_spot4-7, a_spot22 in turn) awards one random unlit spell: +120,000 (ScoreValue(0,
# 120000), no 2,500 for the completing target), spells +1, one rand draw (PickUnlitSpell: RandIndex(count of unlit among
# v_lite28 / 29 / 31 / 32)). Four banks, 200 frames apart (the bank lights flash 1 s). re/test/hook/dragon/D-SPELLS/check_spells.py reads dumps.jsonl
# and compares the chosen spell with an independent LCG computation (the draw is the one after the previous frame's).
# The game has FOUR spell slots but this script drives five awards:
# the first hit at frame 200 ends the launch mode (mode 10 -> 2) and its skill-shot AwardSpell (dragon_ball.cpp:268) takes
# the first slot, banks 1-3 (frames 240 / 480 / 720) take the other three, so bank 4 (frame 960) finds no unlit slot:
# BlockerFControl (dragon_shop.cpp:51, v_lite32 TLightTurnOnTimed) has lit v_lite32 (slot 3, whose AwardSpell case
# calls BlockerFControl(TBlockerDisable)), so after the 4th award all four lights are light_on() and PickUnlitSpell
# returns -1 without a draw, AwardRandomSpell does nothing (dragon_spells.cpp:85-99 and 136-141; FT 0x423600 /
# 0x4237f0, port_listing_dragon.c 535-641).
# Bank 4 therefore expects NO award (score and spells unchanged), with the precondition checked first: four spells and all four
# slot lights showing their lit sprite (bitmap 0; unlit is -1, the value at frame 150).
init window 960 666
init fixed_dt 10
init seed 1
init dump_period 10
init watch v_lite28.light_on v_lite29.light_on v_lite30.light_on v_lite31.light_on v_lite32.light_on v_lite28.flasher_on v_lite29.flasher_on v_lite31.flasher_on v_lite32.flasher_on v_lite28.bitmap v_lite29.bitmap v_lite31.bitmap v_lite32.bitmap a_kout3.active
10 key down new_game
11 key up new_game
200 event a_spot4 ControlCollision
210 event a_spot5 ControlCollision
220 event a_spot6 ControlCollision
230 event a_spot7 ControlCollision
240 event a_spot22 ControlCollision
240 expect n_score == 120000 delta 239
240 expect sound 33
240 expect spells == 1 delta 239
240 expect n_rand_draws == 2 delta 239
440 event a_spot4 ControlCollision
450 event a_spot5 ControlCollision
460 event a_spot6 ControlCollision
470 event a_spot7 ControlCollision
480 event a_spot22 ControlCollision
480 expect n_score == 120000 delta 479
480 expect spells == 1 delta 479
480 expect n_rand_draws == 2 delta 479
680 event a_spot4 ControlCollision
690 event a_spot5 ControlCollision
700 event a_spot6 ControlCollision
710 event a_spot7 ControlCollision
720 event a_spot22 ControlCollision
720 expect n_score == 120000 delta 719
720 expect spells == 1 delta 719
720 expect n_rand_draws == 2 delta 719
920 event a_spot4 ControlCollision
930 event a_spot5 ControlCollision
940 event a_spot6 ControlCollision
950 event a_spot7 ControlCollision
960 event a_spot22 ControlCollision
955 expect spells == 4
955 expect v_lite28.bitmap == 0
955 expect v_lite29.bitmap == 0
955 expect v_lite31.bitmap == 0
955 expect v_lite32.bitmap == 0
960 expect n_score == 0 delta 959
960 expect spells == 0 delta 959
# no PickUnlitSpell draw: a bank frame that awards draws 2 (frames 240 / 480 / 720: 429->431,
# 718->720, 1007->1009) and this frame draws 1 (1296->1297), i.e. one draw fewer
960 expect n_rand_draws == 1 delta 959
1000 quit
