# a_sink9 / GateSinkControl1 (0x4274d0): mode 2, tower 3 selected (v_lite50.message_field != 0): Gate tower sink award.
# Gate sinks 300,000 + text 3010; listing: MultiballCount--, v_lite50 ResetAndTurnOn, ScorePart, UpdateTowerLocks, return.
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
100 poke info_text_box message_field 2
100 poke v_lite50 message_field 1
100 poke v_lite47 light_on 1
100 poke a_dvtraa active 0
100 poke a_dvtrab active 1
110 event a_sink9 ControlCollision
110 expect n_score == 300000 delta 109
110 expect multiball == -1 delta 109
110 expect text info_text_box display id 3010
110 expect v_lite50.light_on == 1
110 expect v_lite50.message_field == 0
110 expect mode == 2
110 expect v_lite47.light_on == 1
110 expect a_dvtraa.active == 0
110 expect a_dvtrab.active == 1
110 expect sound 26
110 expect none sound 24
150 expect n_active_balls == 0 delta 109
160 expect n_active_balls == 0 delta 109
110 dump after v_lite50.light_on v_lite50.message_field v_lite47.light_on a_dvtraa.active a_dvtrab.active
150 dump pre
160 dump late
300 quit
