# Negative control for dm_leak_D-SLAY_fire.uh: same player switch, same counter and same fire group step, but player 1 never starts mode 9,
# so the fire direction 0x439b0c is still 0 and the step counts down (2). The leak script's expect (== 4) would FAIL here,
# which is what shows the leak check depends on the carried state.
init fixed_dt 10
init seed 1
init option Players 2
init dump_period 100
10 key down new_game
11 key up new_game
1000 msg table SwitchToNextPlayer 0
1010 poke info_text_box message_field 9
1011 poke v_lite113 message_field 3
1020 event dragon_fire_light_group ControlNotifyTimerExpired
1021 dump after v_lite113.message_field
1022 expect v_lite113.message_field == 2
1100 quit
