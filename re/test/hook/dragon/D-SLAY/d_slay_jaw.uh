# Dragon jaw. Open: the intro sweep (light_sweeps, 5 s) ends by itself -> ControlTimerExpired type 1038 ->
# OpenDragonJaw (listing 986-1006): v_lite113/114/115 active, a_jaw moves to frame 7 (blocker_state 7), then
# ControlBlockerMoveDone activates a_ramp107 and s_bwal170. Close, timer path: d_slay_jaw_close_timer.uh; close,
# ControlModeEnd path: d_slay_jaw_close_end.uh.
init fixed_dt 10
init seed 1
init dump_period 100
10 key down new_game
11 key up new_game
150 poke info_text_box message_field 9
151 event info_text_box ControlMissionComplete
155 dump closed v_lite113.active v_lite114.active v_lite115.active a_ramp107.active s_bwal170.active a_jaw.blocker_state
156 expect a_jaw.blocker_state == 0
1000 dump open v_lite113.active v_lite114.active v_lite115.active a_ramp107.active s_bwal170.active a_jaw.blocker_state
# listing OpenDragonJaw: v_lite113/114/115 ActiveFlag = 1
1001 expect v_lite113.active == 1
1001 expect v_lite114.active == 1
1001 expect v_lite115.active == 1
# listing OpenDragonJaw: a_jaw TBlockerMoveToFrame 7
1001 expect a_jaw.blocker_state == 7
# listing ControlBlockerMoveDone with the jaw open: a_ramp107 and s_bwal170 ActiveFlag = 1
1001 expect a_ramp107.active == 1
1001 expect s_bwal170.active == 1
1001 expect mode == 9
1200 quit
