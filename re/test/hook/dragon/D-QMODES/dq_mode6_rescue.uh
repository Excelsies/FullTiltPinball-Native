# Mode 6, window path: with all four prison windows lit (group TLightResetAndTurnOn), a_sink18 ControlCollision ends the mode through
# MissionControl(ControlMissionComplete) in mode 2 and CompleteQuest (quests_done +1, jackpot +500,000); v_lite48 (tower state 0 at the start) is turned off again.
init window 960 666
init fixed_dt 10
init seed 1
init watch v_lite48.light_on v_lite48.flasher_on
10 key down new_game
11 key up new_game
200 key down plunger
300 key up plunger
400 event a_spot4 ControlCollision
410 poke a_kout2 message_field 6
420 type NMAX
470 expect mode == 6
683 expect v_lite48.flasher_on == 1
700 place 0 3.0 8.0 0.37 0 1 5 0x1
700 place 1 -3.0 8.0 0.37 0 1 5 0x1
701 hold 0 on
701 hold 1 on
900 msg prison_window_light_group TLightResetAndTurnOn 0
1099 expect mode == 6
1100 event a_sink18 ControlCollision
1101 expect mode == 2
1101 expect quests_done == 1
1101 expect jackpot == 500000 delta 1099
1101 expect v_lite48.flasher_on == 0
1101 expect v_lite48.light_on == 0
1200 quit
