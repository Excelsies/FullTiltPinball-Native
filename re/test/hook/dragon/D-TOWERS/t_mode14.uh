# Mode14Controller (0x42b3c0): Complete -> MultiballCount + 1, ScoreValue(0, 100000), music slot, v_lite77 flashes;
# Started -> text 3062; ControlBallDrained with MultiballCount 1 -> mode 2. ModeStartLights / QuestEndCleanup are not checked here.
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
100 poke info_text_box message_field 14
110 event info_text_box ControlMissionComplete
120 event info_text_box ControlMissionStarted
110 expect multiball == 2
110 expect n_score == 100000 delta 109
110 expect mode == 14
110 expect track 0
120 expect text info_text_box display id 3062
130 event info_text_box ControlBallDrained
130 expect multiball == 2
140 quit
