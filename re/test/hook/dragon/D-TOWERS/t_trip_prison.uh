# PrisonWindowTripwireControl (0x427880), mode 2: score = ScorePart(.., lit windows), Prison [25k, 50k, 75k, 100k]; the group resets after the last.
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
100 poke info_text_box message_field 2
110 event s_trip6 ControlCollision
120 event s_trip5 ControlCollision
