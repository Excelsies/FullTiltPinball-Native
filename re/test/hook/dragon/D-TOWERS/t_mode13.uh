# Mode13Controller (0x42b0e0): Complete -> MultiballCount + 3, tower lights set; Started -> text 3051;
# ball drained at MultiballCount 1 -> mode 2 (QuestEndCleanup is not checked here).
# Complete starts the timed flasher on the nine window lights v_lite104..112 (three window groups).
init fixed_dt 10
init seed 1
init watch v_lite104.flasher_on v_lite105.flasher_on v_lite106.flasher_on v_lite107.flasher_on v_lite108.flasher_on v_lite109.flasher_on v_lite110.flasher_on v_lite111.flasher_on v_lite112.flasher_on
10 key down new_game
11 key up new_game
100 poke info_text_box message_field 13
110 event info_text_box ControlMissionComplete
120 event info_text_box ControlMissionStarted
110 expect multiball == 4
110 expect mode == 13
110 expect v_lite104.flasher_on == 1
110 expect v_lite105.flasher_on == 1
110 expect v_lite106.flasher_on == 1
110 expect v_lite107.flasher_on == 1
110 expect v_lite108.flasher_on == 1
110 expect v_lite109.flasher_on == 1
110 expect v_lite110.flasher_on == 1
110 expect v_lite111.flasher_on == 1
110 expect v_lite112.flasher_on == 1
120 expect text info_text_box display id 3051
130 quit
