# HoleControl (0x426ee0): mode 10 with no selected quest (a_kout2 field 0: Mode10's StartSelectedQuest returns 0, the rules handler runs MissionControl before the part's control function) -> MessageField 2, no eject; any other mode (7) -> MessageField 1 (eject); Kickout3Control sets a_kout3.message_field = 1;
# Kickout3LightControl: timer expired with v_lite29 lit -> a_kout3.active = 1.
init fixed_dt 10
init seed 1
init dump_period 10
init watch a_sink4.message_field s_hole118.message_field a_kout3.message_field a_kout3.active info_text_box.message_field
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 10
201 poke a_kout2 message_field 0
205 event s_hole118 ControlBallCaptured
210 expect s_hole118.message_field == 2
210 expect mode == 10
205-205 expect none sound 30
212 poke s_hole118 message_field 0
213 poke info_text_box message_field 7
214 event s_hole118 ControlBallCaptured
215 expect s_hole118.message_field == 1
215 expect mode == 7
214-214 expect sound 30
220 event a_kout3 ControlCollision
225 expect a_kout3.message_field == 1
230 poke a_kout3 active 0
231 poke v_lite29 light_on 0
235 event v_lite29 ControlTimerExpired
240 expect a_kout3.active == 0
241 poke v_lite29 light_on 1
245 event v_lite29 ControlTimerExpired
250 expect a_kout3.active == 1
260 quit
