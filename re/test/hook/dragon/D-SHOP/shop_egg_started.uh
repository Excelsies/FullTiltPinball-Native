# Mode12EggShopController, ControlMissionStarted entry (0x50): shows the offer's text again without recomputing it and without the
# tabc33 sound. Capture with 7 eggs, v_lite57 off -> offer 7; v_lite57 poked on afterwards must not lower it to 6.
init fixed_dt 10
init seed 1
init dump_period 10
init watch s_hole118.message_field v_lite57.light_on
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 2
210 event s_rexit19 ControlBallToLayer1
213 event s_rexit19 ControlBallToLayer1
216 event s_rexit19 ControlBallToLayer1
219 event s_rexit18 ControlBallToLayer1
240 event s_hole118 ControlBallCaptured
241 expect mode == 12
240 expect text info_text_box display id 3053
240-240 expect sound 31
250 poke v_lite57 light_on 1
255 event s_hole118 ControlMissionStarted
256 expect mode == 12
255 expect text info_text_box display id 3053
255 expect none text info_text_box display id 3054
255-255 expect none sound 31
260 quit
