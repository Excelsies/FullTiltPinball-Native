# WellSinkControl other mode (7): AwardRandomSpell, spells +1
init fixed_dt 10
init seed 1
init dump_period 10
init watch a_sink4.message_field multiplier jackpot spells extra_balls info_text_box.message_field selected_quest ball_held n_rand_draws
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 7
205 event a_sink4 ControlCollision
205 expect spells == 1
205 expect mode == 7
205 expect n_score == 120000 delta 204
205 expect n_rand_draws == 2 delta 204
260 quit
