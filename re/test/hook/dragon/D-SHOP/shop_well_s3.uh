# WellSinkControl mode 8 state 3 (AwardJackpot(0,1): jackpot raised, one RandIndex(4) draw)
init fixed_dt 10
init seed 1
init dump_period 10
init watch a_sink4.message_field multiplier jackpot spells extra_balls info_text_box.message_field selected_quest ball_held n_rand_draws
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 8
201 poke a_sink4 message_field 3
205 event a_sink4 ControlCollision
205 expect n_rand_draws == 2 delta 204
205 expect a_sink4.message_field == 0
205 expect n_score == 1075000 delta 204
205 expect text info_text_box display id 3039
260 quit
