# BumperControl in mode 3 (default branch): ScorePart(bumper, a_bump2's crew) = 1,500 at crew 0; no change to the counters (listing 2497-2549).
init window 960 666
init fixed_dt 10
init seed 1
init watch a_bump1.message_field a_bump2.message_field
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 3
300 event a_bump1 ControlCollision
310 event a_bump2 ControlCollision
320 event a_bump3 ControlCollision
300 expect n_score == 1500 delta 299
300 expect sound 12
310 expect n_score == 1500 delta 309
320 expect n_score == 1500 delta 319
320 expect a_bump1.message_field == 0
320 expect a_bump2.message_field == 0
360 quit
