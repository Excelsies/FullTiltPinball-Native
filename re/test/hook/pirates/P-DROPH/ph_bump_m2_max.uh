# BumperControl mode 2 with the crew already at its maximum 6 (poke): the 12th hit resets a_bump1 but leaves the crew and shows no text.
init window 960 666
init fixed_dt 10
init seed 1
init watch a_bump1.message_field a_bump2.message_field
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 2
205 poke a_bump2 message_field 6
206 poke a_bump1 message_field 11
300 event a_bump1 ControlCollision
300 expect a_bump1.message_field == 0
300 expect a_bump2.message_field == 6
300 expect n_score == 10500 delta 299
300 expect none text info_text_box display id 3001
300 expect sound 13
340 quit
