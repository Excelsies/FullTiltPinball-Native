# O-5 (listing 4446-4583, disassembly 0x429232 / 0x4293c1): LeftOrbitTripwireControl in mode 5 with v_lite600 not
# flashing: SpecialAddScore(50000) (no multiplier, no ladder) and tabb12 (id 11), no text, no combo flash.
# With v_lite600 flashing the original calls Mode5WindHit (pirates_winds.cpp); the second hit only
# checks that the 50,000 award does not happen in that branch.
init window 960 666
init fixed_dt 10
init seed 1
init watch v_lite631.flasher_on v_lite600.flasher_on
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 5
220 event s_trip3 ControlCollision
221 expect n_score == 50000 delta 219
220 expect sound 11
220 expect none text info_text_box display
221 expect v_lite631.flasher_on == 0
230 msg v_lite600 TLightFlasherStartTimedThenStayOn 20
231 expect v_lite600.flasher_on == 1
240 event s_trip3 ControlCollision
241 expect none sound 11
260 quit
