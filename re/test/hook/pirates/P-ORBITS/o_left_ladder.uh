# O-3 (listing 4446-4583, disassembly 0x429210): LeftOrbitTripwireControl s_trip3 outside mode 5.
# Mode 4 (no orbit-light step: field != 2): each hit plays tabb12 (id 11), shows string 3008 and scores ladder[idx] with
# idx = combo step (left_orbit_combo_light_group GetOnCount 0/1/2/>=3 -> 0/3/6/9; 631, 631+632, group, group flashed 2.0 s) +0.
# Ladder (pirates_scores_12): 25000 50000 75000 150000 175000 200000 275000 300000 325000 425000 450000 475000.
# Hits 0.2 s apart (the flashes are still on): 25,000 / 150,000 / 275,000 / 425,000 / 425,000. ControlScorerReplaced (0x4d) resets
# the combo group (Message(0x14, 2.0)), so the next hit is 25,000 again; a hit of ANOTHER scorer (s_trip8) triggers the same reset.
# tabb12 = id 11 (not resolved independently from the DAT; sounds.jsonl info names the control function).
init window 960 666
init fixed_dt 10
init seed 1
init watch v_lite631.flasher_on v_lite632.flasher_on
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 4
220 event s_trip3 ControlCollision
221 expect n_score == 25000 delta 219
220 expect sound 11
220 expect text info_text_box display id 3008
221 expect v_lite631.flasher_on == 1
221 expect v_lite632.flasher_on == 0
240 event s_trip3 ControlCollision
241 expect n_score == 150000 delta 239
240 expect sound 11
241 expect v_lite632.flasher_on == 1
260 event s_trip3 ControlCollision
261 expect n_score == 275000 delta 259
280 event s_trip3 ControlCollision
281 expect n_score == 425000 delta 279
300 event s_trip3 ControlCollision
301 expect n_score == 425000 delta 299
320 event s_trip3 ControlScorerReplaced
340 event s_trip3 ControlCollision
341 expect n_score == 25000 delta 339
360 event s_trip3 ControlCollision
361 expect n_score == 150000 delta 359
380 event s_trip8 ControlCollision
400 event s_trip3 ControlCollision
401 expect n_score == 25000 delta 399
450 quit
