# ShowTreasureBuried 0x424950 branches: the on-count of special_treasure_light_group (v_lite571..576) picks
# text 3034+count (count 0..4) and flashes v_lite571+count (v_lite576 and text 3039 for count >= 5). dig_collect.uh reaches only count 0.
# The real caller EastWindRolloverControl1 (pirates_winds.cpp:317-335) calls DigTreasure(0.0f) only in mode 8 (mode 5
# takes Mode5Hit, other modes score the rollover), so the script pokes mode 8 after every new game (a new game resets
# the mode to 3).
# Dig steps 3 and 4 each call ShowTreasureBuried; a new game (a second `new_game` key) resets the dig state, so each round pokes
# the first k lights of the group (light_on) before step 3 and one more before step 4: rounds give counts (1,2), (3,4), (5,6).
# Count 6 shares the default branch of count 5 (unsigned compare against 4), so only the first call of that round checks the light was off before.
# fact that the poked count selects the branch (an expect on the text id would fail otherwise).
init fixed_dt 10
init seed 1
init dump_period 10
init watch v_lite571.flasher_on v_lite572.flasher_on v_lite573.flasher_on v_lite574.flasher_on v_lite575.flasher_on v_lite576.flasher_on
10 key down new_game
11 key up new_game
140 poke info_text_box message_field 8
160 event a_roll9 ControlCollision
170 event a_roll9 ControlCollision
180 event a_roll9 ControlCollision
195 poke v_lite571 light_on 1
199 expect v_lite572.flasher_on == 0
200 event a_roll9 ControlCollision
200-201 expect text info_text_box display id 3035
201 expect v_lite572.flasher_on == 1
205 poke v_lite572 light_on 1
209 expect v_lite573.flasher_on == 0
210 event a_roll9 ControlCollision
210-211 expect text info_text_box display id 3036
211 expect v_lite573.flasher_on == 1
400 key down new_game
401 key up new_game
540 poke info_text_box message_field 8
550 event a_roll9 ControlCollision
560 event a_roll9 ControlCollision
570 event a_roll9 ControlCollision
585 poke v_lite571 light_on 1
585 poke v_lite572 light_on 1
585 poke v_lite573 light_on 1
589 expect v_lite574.flasher_on == 0
590 event a_roll9 ControlCollision
590-591 expect text info_text_box display id 3037
591 expect v_lite574.flasher_on == 1
595 poke v_lite574 light_on 1
599 expect v_lite575.flasher_on == 0
600 event a_roll9 ControlCollision
600-601 expect text info_text_box display id 3038
601 expect v_lite575.flasher_on == 1
800 key down new_game
801 key up new_game
940 poke info_text_box message_field 8
950 event a_roll9 ControlCollision
960 event a_roll9 ControlCollision
970 event a_roll9 ControlCollision
985 poke v_lite571 light_on 1
985 poke v_lite572 light_on 1
985 poke v_lite573 light_on 1
985 poke v_lite574 light_on 1
985 poke v_lite575 light_on 1
989 expect v_lite576.flasher_on == 0
990 event a_roll9 ControlCollision
990-991 expect text info_text_box display id 3039
991 expect v_lite576.flasher_on == 1
995 poke v_lite576 light_on 1
1000 event a_roll9 ControlCollision
1000-1001 expect text info_text_box display id 3039
1001 expect v_lite576.flasher_on == 1
1100 quit
