# Mode11Controller (FT 0x42cfc0; listing 6971-7101) and Mode11Setup (0x42ce80). Sound: tabb99wave, DAT
# group 71 -> id 67. The finale steps (shared counter 0x435cf8 = 1..9) are not checked here: no dump key and no poke
# reaches the counter.
init fixed_dt 10
init seed 1
init dump_period 10
init watch mode_timer.time_left_ms v_lite606.message_field v_lite505.light_on v_lite504.light_on v_lite568.light_on v_lite568.message_field v_mlite51.flasher_on v_lite4.flasher_on v_lite567.flasher_on a_sink9.active a_sink12.active s_trip3.active s_trip8.active
10 key down new_game
11 key up new_game
190 poke info_text_box message_field 2
191 event info_text_box ControlMissionComplete
195 expect no_hold_start == 0
196 poke v_lite568 light_on 1
200 poke info_text_box message_field 11
201 event info_text_box ControlMissionComplete
201 expect mode == 11
201 expect n_score == 1000000
201 expect text info_text_box display id 3066
201 expect sound 67
201 expect a_sink9.active == 1
201 expect a_sink12.active == 1
201 expect s_trip3.active == 0
201 expect s_trip8.active == 0
201 expect v_lite568.message_field == 1   # the extra-ball light was lit: remembered as 1
201 expect v_mlite51.flasher_on == 1
201 expect v_lite4.flasher_on == 1
201 expect v_lite567.flasher_on == 1
300 event light_sweeps ControlTimerExpired
300 expect text info_text_box display id 3054
301 expect mode_timer.time_left_ms in 30600 30680
310 expect jackpot == 1040000   # sink release (+40,000 pre-hook) lands at frame 306 here (cause UNVERIFIED), 300 in mode 8
# a TLightRollover hit: +50,000
320 event v_mlite7 ControlCollision
321 expect jackpot == 1090000
# mode timer expiry: ModeEnd
400 poke v_lite606 message_field 2
401 event mode_timer ControlTimerExpired
402 expect v_lite606.message_field == 3
402 expect mode11_done == 1
402 expect mode == 2
402 expect jackpot == 1840000
402 expect a_sink9.active == 0
402 expect a_sink12.active == 0
402 expect s_trip3.active == 1
402 expect s_trip8.active == 1
402 expect v_lite504.light_on == 0
402 expect v_lite505.light_on == 1
402 expect v_lite568.light_on == 1   # field 1: ResetAndTurnOn
402 expect v_lite567.flasher_on == 0
# drain in mode 11
500 poke info_text_box message_field 11
501 event mode_timer ControlBallDrained
502 expect v_lite606.message_field == 4
502 expect mode == 2
550 quit
