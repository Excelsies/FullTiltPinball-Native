# B7 (listing 5335-5359): a_sink8 ControlTimerExpired outside mode 12 plays tabb55wave; in mode 12 it does nothing.
# ControlCollision restarts the sink's timer (TSinkResetTimer) and makes no sound.
# Sound id: tabb55wave 40 (sounds.jsonl).
init fixed_dt 10
init seed 1
10 key down new_game
11 key up new_game
200 poke info_text_box message_field 2
210 event a_sink8 ControlTimerExpired
210 expect sound 40
220 poke info_text_box message_field 12
230 event a_sink8 ControlTimerExpired
230 expect none sound 40
240 event a_sink8 ControlCollision
240 expect none sound 40
260 quit
