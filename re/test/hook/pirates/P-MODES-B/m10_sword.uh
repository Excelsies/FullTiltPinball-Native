# Mode10Controller (FT 0x42cc10; listing 6864-6934): score 250,000, sweeps 11.0, flashers -1.0 on
# v_lite9-11 / 551-548, strings 3065 / 3052, timer 29.38 s, ModeEnd tail, drain path.
# Jackpot ledger: +40,000 arrives at the light_sweeps ControlTimerExpired event, not at the mode end. The sweep branch
# calls ReleaseHoldSink (pirates_core.cpp) -> a_sink8 TSinkResetTimer adds a ball at the sink (TSink::TimerExpired:
# n_active_balls 2 -> 3, frame 301 (event at 300)) and calls the handler with the sink as caller, so the control call
# reaches MissionControl, whose code-agnostic TSink pre-hook (pirates_rules.cpp, FT 0x42d850: caller TypeId 1017 ->
# AddJackpot(40000)) adds 40,000. The mode end itself adds 750,000 (modes 4-11).
# Held-ball precondition: the game starts in mode 3 with no_hold_start = 1 (Mode3LaunchController ControlMissionComplete,
# pirates_ball.cpp:251 = FT 0x42abf0 sets the no-held-ball global to 1, PIRATES.EXE.c:28569), and the sweep branch of
# this mode calls ReleaseHoldSink only when NoHeldBall == 0 (pirates_modes_b.cpp; FT: the sweep branch calls
# ReleaseHoldSink only while that global is 0, PIRATES.EXE.c:29495). Forcing the mode from the skill lane would skip the
# release (n_active_balls 2, jackpot 1,000,000 at the sweep, 1,750,000 at the mode end). The ball is held in a real game,
# so the script enters mode 2 first: `190 poke info_text_box message_field 2` + `191 event info_text_box
# ControlMissionComplete` runs Mode2IdleController (pirates_ball.cpp:211 NoHeldBall = 0, FT 0x42ab90) and
# `195 expect no_hold_start == 0` states the precondition.
init fixed_dt 10
init seed 1
init dump_period 10
init watch mode_timer.time_left_ms v_lite606.message_field v_lite505.light_on v_lite504.light_on v_lite9.flasher_on v_lite10.flasher_on v_lite11.flasher_on v_lite551.flasher_on v_lite550.flasher_on v_lite549.flasher_on v_lite548.flasher_on
10 key down new_game
11 key up new_game
190 poke info_text_box message_field 2
191 event info_text_box ControlMissionComplete
195 expect no_hold_start == 0
200 poke info_text_box message_field 10
201 event info_text_box ControlMissionComplete
201 expect mode == 10
201 expect n_score == 250000
201 expect text info_text_box display id 3065
201 expect sound 54
201 expect v_lite9.flasher_on == 1
201 expect v_lite10.flasher_on == 1
201 expect v_lite11.flasher_on == 1
201 expect v_lite551.flasher_on == 1
201 expect v_lite550.flasher_on == 1
201 expect v_lite549.flasher_on == 1
201 expect v_lite548.flasher_on == 1
300 event light_sweeps ControlTimerExpired
300 expect text info_text_box display id 3052
301 expect mode_timer.time_left_ms in 29300 29380
301 expect n_active_balls == 3
301 expect jackpot == 1040000
400 poke v_lite606 message_field 2
401 event mode_timer ControlTimerExpired
402 expect v_lite606.message_field == 3
402 expect v_lite504.light_on == 0
402 expect v_lite505.light_on == 1
402 expect jackpot == 1790000
402 expect mode == 2
500 poke info_text_box message_field 10
501 event mode_timer ControlBallDrained
502 expect mode_timer.time_left_ms == 0
502 expect v_lite606.message_field == 4
502 expect mode == 2
550 quit
