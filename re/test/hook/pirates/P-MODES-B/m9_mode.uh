# Mode9Controller (FT 0x42ca00; listing 6796-6861): score 100,000, sweeps 10.0, blockers a_blocc / a_blocf /
# a_blocg to frame 0, strings 3064 / 3051, timer 48.28 s, ModeEnd tail, drain path.
# The sink release arrives 8 frames after the sweeps event here (1 frame in m7 / m10; cause not isolated); the 320 expect is loose.
# Jackpot ledger: +40,000 arrives at the light_sweeps ControlTimerExpired event, not at the mode end. The sweep branch
# calls ReleaseHoldSink (pirates_core.cpp) -> a_sink8 TSinkResetTimer adds a ball at the sink (TSink::TimerExpired:
# n_active_balls 2 -> 3, frame 308 (event at 300; read at 320)) and calls the handler with the sink as caller, so the
# control call reaches MissionControl, whose code-agnostic TSink pre-hook (pirates_rules.cpp, FT 0x42d850: caller TypeId
# 1017 -> AddJackpot(40000)) adds 40,000. The mode end itself adds 750,000 (modes 4-11).
# Held-ball precondition: the game starts in mode 3 with no_hold_start = 1 (Mode3LaunchController ControlMissionComplete,
# pirates_ball.cpp:251 = FT 0x42abf0 sets the no-held-ball global to 1, PIRATES.EXE.c:28569), and the sweep branch of
# this mode calls ReleaseHoldSink only when NoHeldBall == 0 (pirates_modes_b.cpp; FT: the sweep branch calls
# ReleaseHoldSink only while that global is 0, PIRATES.EXE.c:29431). Forcing the mode from the skill lane would skip the
# release (n_active_balls 2, jackpot 1,000,000 at the sweep, 1,750,000 at the mode end). The ball is held in a real game,
# so the script enters mode 2 first: `190 poke info_text_box message_field 2` + `191 event info_text_box
# ControlMissionComplete` runs Mode2IdleController (pirates_ball.cpp:211 NoHeldBall = 0, FT 0x42ab90) and
# `195 expect no_hold_start == 0` states the precondition.
init fixed_dt 10
init seed 1
init dump_period 10
init watch mode_timer.time_left_ms v_lite606.message_field v_lite505.light_on v_lite504.light_on v_lite547.flasher_on
10 key down new_game
11 key up new_game
190 poke info_text_box message_field 2
191 event info_text_box ControlMissionComplete
195 expect no_hold_start == 0
200 poke info_text_box message_field 9
201 event info_text_box ControlMissionComplete
201 expect mode == 9
201 expect n_score == 100000
201 expect text info_text_box display id 3064
201 expect sound 52
# a non-timer, non-sweeps caller does nothing
250 event v_lite547 ControlTimerExpired
251 expect mode_timer.time_left_ms == 0
251 expect v_lite547.flasher_on == 0
300 event light_sweeps ControlTimerExpired
300 expect text info_text_box display id 3051
301 expect mode_timer.time_left_ms in 48200 48280
320 expect n_active_balls == 3
320 expect jackpot == 1040000
400 poke v_lite606 message_field 2
401 event mode_timer ControlTimerExpired
402 expect v_lite606.message_field == 3
402 expect v_lite504.light_on == 0
402 expect v_lite505.light_on == 1
402 expect jackpot == 1790000
402 expect mode == 2
# drain path: timer stopped, mode ends
500 poke info_text_box message_field 9
501 event mode_timer ControlBallDrained
502 expect mode_timer.time_left_ms == 0
502 expect v_lite606.message_field == 4
502 expect mode == 2
550 quit
