{
  "name": "smoke",
  "description": "Start, new game, plunge, a few flips; screenshots at each stage. Shots are kept 0.2 s away from key events because a capture blocks the replay for ~50-80 ms.",
  "steps": [
    {"wait": 3.0},
    {"shot": "start", "crops": ["score"]},
    {"wait": 0.2},
    {"tap": "new_game"},
    {"wait": 2.0},
    {"shot": "new_game", "crops": ["score"]},
    {"wait": 0.2},
    {"down": "plunger"},
    {"wait": 0.8},
    {"shot": "plunger_pulled"},
    {"wait": 0.2},
    {"up": "plunger"},
    {"wait": 0.4},
    {"shot": "plunged"},
    {"wait": 2.0},
    {"shot": "ball_in_play"},
    {"wait": 0.2},
    {"tap": "left_flipper", "hold": 0.25},
    {"wait": 0.05},
    {"down": "right_flipper"},
    {"wait": 0.1},
    {"shot": "flippers"},
    {"wait": 0.2},
    {"up": "right_flipper"},
    {"wait": 1.0},
    {"tap": "left_flipper", "hold": 0.2},
    {"tap": "right_flipper", "hold": 0.2},
    {"wait": 2.0},
    {"shot": "end", "crops": ["score", "panel"]}
  ]
}
