# Flipper flags reach Rules->BackdoorKey, right flipper, against the real DragonRules. Lead-in = D-BALL/db_last.uh
# (three unsaved drains; at 6910 last_ball == 1, mode 11, text 3012). DragonRules::BackdoorKey (dragon_rules.cpp:222-226) sends TFlipperExtend
# to Mode11BonusController only when mode == 11, last_ball != 0 and a flipper flag is set; that sets the skip flag and clears the text, so the
# 2 s step text 3017 that db_last.uh sees at 7104-7106 never appears (D-BONUS dbn_skip.uh drives the same rule with a message). Without the
# flag reaching the rules nothing would suppress it.
init window 960 666
init fixed_dt 10
init seed 1
init dump_period 10
10 key down new_game
11 key up new_game
200 key down plunger
300 key up plunger
360 event s_oneway2 ControlCollision
1900 place 0 0 15.6 0.37 0 1 5 0x1
1910 expect mode == 11
2700 key down plunger
2800 key up plunger
2860 event s_oneway2 ControlCollision
4400 place 0 0 15.6 0.37 0 1 5 0x1
4410 expect mode == 11
5200 key down plunger
5290 key up plunger
5350 event s_oneway2 ControlCollision
6890 expect ball_save == 0
6890 expect multiball == 1
6900 place 0 0 15.6 0.37 0 1 5 0x1
6910 expect last_ball == 1
6910 expect tilt_lock == 1
6910 expect mode == 11
6950 key down right_flipper
6955 key up right_flipper
6960-7400 expect none text info_text_box display id 3017
7700 expect mode == 0
7700 expect last_ball == 0
7800 quit
