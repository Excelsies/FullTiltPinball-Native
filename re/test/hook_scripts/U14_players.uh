# DRAGON: per-player MessageField of TSoloTarget, TDrain and TPlunger over a player change.
# Expected values from part_base_message 5 and the U11a_kickout.uh K4/K5 pattern (FT 0x3fe swaps, 0x402 resets), not game text.
init window 960 666
init fixed_dt 10
init seed 1
init option Players 2
init watch a_spot22.message_field drain.message_field s_plunger1.message_field
10 key down new_game
11 key up new_game
120 poke a_spot22 message_field 3
120 poke drain message_field 4
120 poke s_plunger1 message_field 5
121 expect a_spot22.message_field == 3
121 expect drain.message_field == 4
121 expect s_plunger1.message_field == 5
130 msg table SwitchToNextPlayer 0
131 expect a_spot22.message_field == 0
131 expect drain.message_field == 0
131 expect s_plunger1.message_field == 0
140 msg table SwitchToNextPlayer 0
141 expect a_spot22.message_field == 3
141 expect drain.message_field == 4
141 expect s_plunger1.message_field == 5
# Reset zeroes the field and all saved copies
150 msg a_spot22 Reset 0
150 msg drain Reset 0
150 msg s_plunger1 Reset 0
151 expect a_spot22.message_field == 0
151 expect drain.message_field == 0
151 expect s_plunger1.message_field == 0
160 msg table SwitchToNextPlayer 0
161 expect a_spot22.message_field == 0
161 expect drain.message_field == 0
161 expect s_plunger1.message_field == 0
170 msg table SwitchToNextPlayer 0
171 expect a_spot22.message_field == 0
171 expect drain.message_field == 0
171 expect s_plunger1.message_field == 0
200 quit
